rules_version = '2';

// Catanna: app privada. Hace falta cuenta para todo.
// - Los clientes leen lo publicado y escriben solo su propia valoración (id = su uid).
// - Las cuentas con documento en admins/{uid} gestionan el catálogo desde la maestra.
service cloud.firestore {
  match /databases/{db}/documents {

    function dentro() {
      return request.auth != null;
    }

    function admin() {
      return dentro() && exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }

    function nota(n) {
      return n is int && n >= 1 && n <= 5;
    }

    function resenaValida(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'alias', 'texto', 'estrellas', 'potencia', 'fecha'])
        && d.uid == uid
        && d.alias is string && d.alias.size() <= 12
        && d.texto is string && d.texto.size() <= 2000
        && nota(d.estrellas) && nota(d.potencia)
        && d.fecha == request.time;
    }

    // Solo se crean a mano desde la consola.
    match /admins/{uid} {
      allow read: if dentro() && request.auth.uid == uid;
      allow write: if false;
    }

    match /productos/{id} {
      allow read: if admin() || (dentro() && resource.data.publicado == true);
      allow write: if admin();

      match /resenas/{uid} {
        allow create, update: if dentro() && request.auth.uid == uid && resenaValida(uid);
        allow delete: if (dentro() && request.auth.uid == uid) || admin();
      }
    }

    // La app lee todas las valoraciones de golpe para calcular etiquetas y notas.
    match /{ruta=**}/resenas/{uid} {
      allow read: if dentro();
    }
  }
}
